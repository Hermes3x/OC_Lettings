# Copy this file to .env and fill in the values.
# SECRET_KEY: generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# SENTRY_DSN: the DSN of the Sentry project (Settings > Client Keys).
SENTRY_DSN=
# DEBUG: True in development only. Leave it out (or False) in production.
DEBUG=True
# ALLOWED_HOSTS: comma-separated domain names the site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
